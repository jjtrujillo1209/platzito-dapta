# ── Instancia ──────────────────────────────────────────────────────────────
ENTORNO=desarrollo                       # produccion activa validaciones estrictas (firmas, SSRF)
URL_PUBLICA=http://localhost:8700        # URL pública ESTABLE: Meta y Retell llaman aquí (webhooks y WS de voz)
DATABASE_URL=sqlite:///datos/platzito.db # en producción: postgresql://usuario:clave@host:5432/platzito
CLAVE_SECRETA=cambia-esto-por-una-cadena-larga-y-aleatoria
CLAVE_CIFRADO=                           # Fernet (opcional): python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRETO_TICK=                            # para POST /interno/tick desde un cron externo
PLANIFICADOR_ACTIVO=true
PLANIFICADOR_INTERVALO_S=30

# ── LLM por defecto (cada espacio puede poner sus propias llaves en Ajustes → Integraciones) ──
LLM_PROVEEDOR=anthropic                  # anthropic | openai | groq | gemini | ollama
LLM_MODELO=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# ── Embeddings (nunca falsos en producción) ──
EMBEDDINGS_PROVEEDOR=ollama              # ollama | openai
EMBEDDINGS_MODELO=nomic-embed-text       # con openai: text-embedding-3-small

# ── Voz ──
RETELL_API_KEY=

# ── WhatsApp (Meta Cloud API directo, Tech Provider) ──
META_APP_ID=
META_APP_SECRET=                         # valida X-Hub-Signature-256 de los webhooks
META_CONFIG_ID=                          # configuración de Embedded Signup
META_VERIFY_TOKEN=platzito-verify
META_GRAPH_VERSION=v23.0

# ── Correo saliente ──
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
